{
    "name": "notakey/simplesamlphp-module-notakey",
    "description": "A SimpleSAMLphp module adding support for Notakey multi factor authentication with free mobile app.",
    "type": "simplesamlphp-module",
    "keywords": ["notakey", "2fa"],
    "license": "MIT",
    "authors": [{
        "name": "Ingemars Asmanis",
        "email": "ingemars.asmanis@notakey.com"
    }],
    "require": {
        "php": "^8.3",
        "simplesamlphp/composer-module-installer": "^1.7",
        "simplesamlphp/simplesamlphp": "^2.5",
        "symfony/http-client": "^7.4",
        "mobiledetect/mobiledetectlib": "^4.8",
        "chillerlan/php-qrcode": "^6.0"
    },
    "config": {
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SimpleSAML\\Module\\notakey\\": "src/"
        }
    }
}
